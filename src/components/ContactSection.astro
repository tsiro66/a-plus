---
import SocialIcon from './SocialIcon.astro';
import contact from '../content/pages/contact.json';

const { people, social } = contact;

const colors = ["bg-gray-400", "bg-blue-500", "bg-pink-400", "bg-orange-500", "bg-green-800"];
---

<section class="px-8 md:px-16 lg:px-24 py-16 sm:py-24">
  <!-- Header — asymmetric like other pages -->
  <div class="grid grid-cols-1 lg:grid-cols-5 gap-6 mb-12 sm:mb-16">
    <div class="contact-card lg:col-span-2 flex flex-col justify-center">
      <h1
        class="text-3xl sm:text-4xl md:text-5xl font-bold text-black leading-tight"
      >
        {contact.introTitle}
      </h1>
      <p
        class="mt-4 text-gray-600 font-google-sans text-base sm:text-lg leading-relaxed whitespace-pre-line"
      >
        {contact.introText}
      </p>
    </div>
    <div
      class="contact-card lg:col-span-3 bg-forest p-6 sm:p-8 shadow-sm flex items-center"
    >
      <p
        class="text-white/80 font-google-sans text-base sm:text-lg leading-relaxed whitespace-pre-line"
      >
        {contact.introQuote}
      </p>
    </div>
  </div>

  <!-- Contact grid — each person + social in equal boxes -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {people.map((person, i) => (
      <div class="contact-card bg-zinc-50 border border-forest/40 corner-extend">
        <div class="p-5 sm:p-6 lg:p-8">
          <div class={`w-11 h-11 ${colors[i % colors.length]} mb-4`}></div>
          <h3 class="text-lg sm:text-xl font-bold text-black">{person.name}</h3>
          <span class="text-sm text-black/60 font-google-sans mt-1 block">{person.role}</span>
          <a href={`mailto:${person.email}`} class="text-sm text-black/60 font-google-sans mt-3 block hover:text-forest transition-colors">{person.email}</a>
          <a href={`tel:${person.phone.replace(/\s+/g, "")}`} class="text-sm text-black/60 font-google-sans block hover:text-forest transition-colors">{person.phone}</a>
        </div>
      </div>
    ))}

    <!-- Social links — same size as a person box -->
    <div class="contact-card bg-forest shadow-sm">
      <div class="p-5 sm:p-6 lg:p-8">
        <div class="w-11 h-10 mb-4 flex items-center">
          <span class="text-white/40 text-xs font-google-sans uppercase tracking-widest">Social</span>
        </div>
        <h3 class="text-lg sm:text-xl font-bold text-white mb-1">{contact.socialTitle}</h3>
        <div class="flex gap-3 mt-3">
          {social.map((item) => (
            <a href={item.href} class="w-10 h-10 bg-white/10 flex items-center justify-center hover:bg-white/20 transition-colors duration-200" aria-label={item.platform}>
              <SocialIcon platform={item.platform} class="w-5 h-5 text-white" />
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-card {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.6s ease-out,
      transform 0.6s ease-out;
  }
  .contact-card.visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-card {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const cards = document.querySelectorAll(".contact-card");
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry, i) => {
          if (entry.isIntersecting) {
            setTimeout(() => entry.target.classList.add("visible"), i * 100);
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 },
    );
    cards.forEach((card) => observer.observe(card));
  });
</script>
