---
import MainLayout from "../layouts/MainLayout.astro";
import terms from "../content/pages/terms.json";
---

<MainLayout title="Όροι Χρήσης">
  <article class="px-8 md:px-16 lg:px-24 py-16 sm:py-24">
    <div class="max-w-3xl mx-auto text-black">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-4">Όροι Χρήσης</h1>
      <p class="text-sm text-black/50 font-google-sans mb-12">Τελευταία ενημέρωση: {terms.lastUpdated}</p>

      <div class="space-y-8 text-black/80 font-google-sans leading-relaxed">
        {terms.sections.map((section) => (
          <section>
            <h2 class="text-xl font-bold text-black mb-3">{section.heading}</h2>
            <p class="whitespace-pre-line">{section.text}</p>
          </section>
        ))}
      </div>
    </div>
  </article>
</MainLayout>
