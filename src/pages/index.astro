---
import { Font } from 'astro:assets';
import '../styles/global.css';

const email = 'antonakakisc@yahoo.gr';
---

<!doctype html>
<html lang="el">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="A+ ΜΗΧΑΝΙΚΟΙ — η ιστοσελίδα έρχεται σύντομα." />
    <title>A+ ΜΗΧΑΝΙΚΟΙ — Έρχεται σύντομα</title>

    <Font cssVariable="--font-geom" />
    <Font cssVariable="--font-google-sans" />
    <Font cssVariable="--font-sansation" />
    <Font cssVariable="--font-syne" />
  </head>
  <body class="bg-zinc-50 font-geom min-h-screen flex flex-col">
    <!-- Vertical line on the side, like the site -->
    <div class="side-line" aria-hidden="true"></div>
    <!-- Top bar — logo, identical to site navbar -->
    <header class="bg-zinc-50 border-b border-forest/40">
      <div class="flex h-16 items-center overflow-visible">
        <a href="/" class="group flex self-stretch no-underline">
          <!-- Logo cell -->
          <div
            class="shrink-0 flex items-center px-2 md:px-6 lg:w-[var(--nav-logo-w)] lg:px-0 lg:justify-center border-r border-forest/40 self-stretch relative"
          >
            <div class="flex items-start ml-2">
              <span class="text-5xl font-bold text-forest leading-none font-sansation">A</span>
              <span class="text-4xl font-bold text-forest/70 -mt-1 -ml-1 leading-none">+</span>
            </div>
          </div>

          <!-- Text cell -->
          <div
            class="hidden lg:flex shrink-0 items-center border-r border-forest/40 self-stretch"
          >
            <div class="flex flex-col justify-center">
              <span
                class="text-xl font-bold text-black tracking-[0.2em] leading-tight uppercase font-geom px-8 text-center"
              >
                Μηχανικοι
              </span>
              <div class="h-[1px] w-full bg-forest/30 my-1"></div>
              <div
                class="flex justify-between items-center text-[10px] text-gray-500 font-medium tracking-widest uppercase px-8"
              >
                <span>Μελέτη</span>
                <span class="text-forest/40 text-[6px] mx-1">●</span>
                <span>Αδειοδότηση</span>
                <span class="text-forest/40 text-[6px] mx-1">●</span>
                <span>Κατασκευή</span>
              </div>
            </div>
          </div>
        </a>
      </div>
    </header>

    <!-- Center -->
    <main class="flex-1 flex items-center justify-center px-8">
      <div class="text-center max-w-2xl">
        <p class="text-sm text-forest/60 font-google-sans tracking-widest uppercase mb-6">
          A+ Μηχανικοί
        </p>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-black leading-tight mb-6">
          Έρχεται σύντομα
        </h1>
        <p class="text-gray-600 font-google-sans text-base sm:text-lg leading-relaxed mb-10">
          Η νέα μας ιστοσελίδα ετοιμάζεται. Στο μεταξύ, επικοινωνήστε μαζί μας.
        </p>
        <div class="border-t border-forest/30 pt-8 inline-block">
          <p class="text-sm text-black/60 font-google-sans tracking-widest uppercase mb-2">
            Επικοινωνία
          </p>
          <a
            href={`mailto:${email}`}
            class="text-lg sm:text-xl font-medium text-forest hover:text-forest/70 transition-colors no-underline"
          >
            {email}
          </a>
        </div>
      </div>
    </main>

    <!-- Bottom -->
    <footer class="border-t border-forest/40">
      <div class="flex items-center justify-center px-6 h-14">
        <p class="text-xs font-google-sans text-forest/50">&copy; 2026 A+ ΜΗΧΑΝΙΚΟΙ</p>
      </div>
    </footer>
  </body>
</html>

<style>
  /* Remove the desktop forest sidebar strip — not part of the coming-soon layout */
  body::before {
    display: none;
  }

  /* Thin vertical line below the logo column — mirrors the site's main-content line */
  .side-line {
    position: fixed;
    top: 4rem;
    bottom: 3.5rem;
    left: calc(var(--nav-logo-w) - 1px);
    width: 1px;
    background-color: var(--color-forest);
    opacity: 0.4;
    pointer-events: none;
    z-index: 1;
  }
  @media (max-width: 1023px) {
    .side-line {
      display: none;
    }
  }

  h1,
  p {
    animation: fadeUp 0.8s ease-out forwards;
  }
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
