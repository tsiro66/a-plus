---
const team = [
  { name: "Όνομα Επώνυμο", role: "Πολιτικός Μηχανικός", color: "bg-gray-400" },
  { name: "Όνομα Επώνυμο", role: "Αρχιτέκτονας", color: "bg-blue-500" },
  { name: "Όνομα Επώνυμο", role: "Αρχιτέκτονας", color: "bg-pink-400" },
  { name: "Όνομα Επώνυμο", role: "Αρχιτέκτονας", color: "bg-orange-500" },
  { name: "Όνομα Επώνυμο", role: "Αρχιτέκτονας", color: "bg-green-800" },
];
---

<section class="px-8 md:px-16 lg:px-24 py-16 sm:py-24">
  <!-- Header — asymmetric like other pages -->
  <div class="grid grid-cols-1 lg:grid-cols-5 gap-6 mb-12 sm:mb-16">
    <div class="contact-card lg:col-span-2 flex flex-col justify-center">
      <h1
        class="text-3xl sm:text-4xl md:text-5xl font-bold text-black leading-tight"
      >
        Επικοινωνία
      </h1>
      <p
        class="mt-4 text-gray-600 font-google-sans text-base sm:text-lg leading-relaxed"
      >
        Είμαστε στη διάθεσή σας για να συζητήσουμε το επόμενο έργο σας.
        Επικοινωνήστε μαζί μας με τον τρόπο που σας βολεύει.
      </p>
    </div>
    <div
      class="contact-card lg:col-span-3 bg-forest p-6 sm:p-8 shadow-sm flex items-center"
    >
      <p
        class="text-white/80 font-google-sans text-base sm:text-lg leading-relaxed"
      >
        Lorem ipsum dolor sit amet consectetur adipisicing elit. Aliquam, itaque
        est eum maxime explicabo quos harum sapiente culpa autem voluptatem
        accusamus doloremque.
      </p>
    </div>
  </div>

  <!-- Contact grid — each person + social in equal boxes -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {team.map((member) => (
      <div class="contact-card bg-zinc-50 border border-forest/40 corner-extend">
        <div class="p-5 sm:p-6 lg:p-8">
          <div class={`w-11 h-11 ${member.color} mb-4`}></div>
          <h3 class="text-lg sm:text-xl font-bold text-black">{member.name}</h3>
          <span class="text-sm text-black/60 font-google-sans mt-1 block">{member.role}</span>
          <a href="mailto:email@a-plus.gr" class="text-sm text-black/60 font-google-sans mt-3 block hover:text-forest transition-colors">email@a-plus.gr</a>
          <a href="tel:+302100000000" class="text-sm text-black/60 font-google-sans block hover:text-forest transition-colors">+30 210 000 0000</a>
        </div>
      </div>
    ))}

    <!-- Social links — same size as a person box -->
    <div class="contact-card bg-forest shadow-sm">
      <div class="p-5 sm:p-6 lg:p-8">
        <div class="w-11 h-10 mb-4 flex items-center">
          <span class="text-white/40 text-xs font-google-sans uppercase tracking-widest">Social</span>
        </div>
        <h3 class="text-lg sm:text-xl font-bold text-white mb-1">Ακολουθήστε μας</h3>
        <div class="flex gap-3 mt-3">
          <a href="#" class="w-10 h-10 bg-white/10 flex items-center justify-center hover:bg-white/20 transition-colors duration-200" aria-label="Facebook">
            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="#" class="w-10 h-10 bg-white/10 flex items-center justify-center hover:bg-white/20 transition-colors duration-200" aria-label="Instagram">
            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
          <a href="#" class="w-10 h-10 bg-white/10 flex items-center justify-center hover:bg-white/20 transition-colors duration-200" aria-label="LinkedIn">
            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-card {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.6s ease-out,
      transform 0.6s ease-out;
  }
  .contact-card.visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-card {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const cards = document.querySelectorAll(".contact-card");
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry, i) => {
          if (entry.isIntersecting) {
            setTimeout(() => entry.target.classList.add("visible"), i * 100);
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 },
    );
    cards.forEach((card) => observer.observe(card));
  });
</script>
