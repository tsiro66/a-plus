---
import RollLink from './RollLink.astro';
---

<footer class="lg:sticky bottom-0 z-0 bg-forest text-white overflow-hidden">
  <div class="px-6 sm:px-10 md:px-16 lg:pl-[calc(var(--nav-logo-w)+2rem)] lg:pr-24 py-10 sm:py-16 lg:py-20 relative">

    <!-- Watermark logo -->
    <span class="absolute -right-30 top-2/3 -translate-y-1/2 rotate-90 origin-center
     font-bold font-sansation text-white/[0.03] leading-none select-none pointer-events-none flex items-start" aria-hidden="true">
      <span class="text-[28rem]">A</span>
      <span class="text-[22rem] -mt-[3rem] -ml-[1rem]">+</span>
    </span>

    <!-- Footer content -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-8 sm:mt-12">

      <!-- Navigation -->
      <nav aria-label="Πλοήγηση υποσέλιδου">
        <h3 class="text-sm font-bold uppercase tracking-widest text-white/40 mb-6">Πλοήγηση</h3>
        <ul class="space-y-3">
          <li><RollLink href="/about" text="Ποιοι είμαστε" class="text-white/70 hover:text-white text-sm" /></li>
          <li><RollLink href="/services" text="Υπηρεσίες" class="text-white/70 hover:text-white text-sm" /></li>
          <li><RollLink href="/work" text="Τα έργα μας" class="text-white/70 hover:text-white text-sm" /></li>
          <li><RollLink href="/contact" text="Επικοινωνία" class="text-white/70 hover:text-white text-sm" /></li>
        </ul>
      </nav>

      <!-- Contact -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-widest text-white/40 mb-6">Επικοινωνία</h3>
        <ul class="space-y-3 text-sm text-white/70 font-google-sans">
          <li>info@aplus.gr</li>
          <li>+30 210 000 0000</li>
          <li>Αθήνα, Ελλάδα</li>
        </ul>
        <div class="flex gap-4 mt-6">
          <a href="#" class="text-white/40 hover:text-white transition-colors duration-200" aria-label="Facebook">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="#" class="text-white/40 hover:text-white transition-colors duration-200" aria-label="Instagram">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
          <a href="#" class="text-white/40 hover:text-white transition-colors duration-200" aria-label="LinkedIn">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        </div>
      </div>

      <!-- CTA -->
      <div class="flex flex-col justify-between">
        <div>
          <h3 class="text-sm font-bold uppercase tracking-widest text-white/40 mb-6">Ξεκινήστε</h3>
          <p class="text-white/60 text-sm font-google-sans mb-6">Έτοιμοι να συζητήσουμε το επόμενο έργο σας.</p>
        </div>
        <RollLink href="/contact" text="Επικοινωνήστε μαζί μας" class="gap-2 text-white font-medium text-sm px-6 py-3 transition-colors duration-300
         w-fit border corner-extend">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" /></svg>
        </RollLink>
      </div>

    </div>

    </div>

  <!-- Bottom bar — full width -->
  <div class="border-t border-white/10 px-6 sm:px-10 md:px-16 lg:pl-[calc(var(--nav-logo-w)+2rem)] lg:pr-24 py-8 flex flex-col sm:flex-row justify-between items-center gap-4">
    <div class="flex flex-col sm:flex-row items-center gap-4 sm:gap-6">
      <p class="text-white/40 text-xs font-google-sans">&copy; 2026 A+. Με επιφύλαξη παντός δικαιώματος.</p>
      <div class="flex gap-4 items-center">
        <a href="/privacy" class="text-white/40 hover:text-white transition-colors duration-200 text-xs font-google-sans">Πολιτική Απορρήτου</a>
        <a href="/terms" class="text-white/40 hover:text-white transition-colors duration-200 text-xs font-google-sans">Όροι Χρήσης</a>
      </div>
    </div>
    <a href="https://flux-web.com" target="_blank" rel="noopener" class="text-white/40 hover:text-white transition-colors duration-200 text-xs font-google-sans">Made by <span class="font-syne font-extrabold tracking-wide">FLUX</span></a>
  </div>
</footer>
