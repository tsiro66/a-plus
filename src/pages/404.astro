---
import MainLayout from "../layouts/MainLayout.astro";
import RollLink from "../components/RollLink.astro";
import notFound from "../content/pages/404.json";
---

<MainLayout title="Σελίδα δεν βρέθηκε">
  <section class="px-8 md:px-16 lg:px-24 py-24 sm:py-32 min-h-[calc(100vh-64px)] flex items-center">
    <div class="max-w-2xl mx-auto text-center text-black">
      <p class="text-sm text-forest/60 font-google-sans tracking-widest uppercase mb-4">{notFound.badge}</p>
      <h1 class="text-5xl sm:text-6xl md:text-7xl font-bold mb-6 whitespace-pre-line">{notFound.title}</h1>
      <p class="text-gray-600 font-google-sans text-base sm:text-lg leading-relaxed mb-10 whitespace-pre-line">
        {notFound.text}
      </p>
      <RollLink
        href="/"
        text={notFound.button}
        class="corner-extend group/link gap-2 border border-forest/40 text-forest font-medium text-base sm:text-lg px-8 py-3.5"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-5 h-5 transition-transform duration-300 group-hover/link:translate-x-2"
          viewBox="0 0 20 20"
          fill="currentColor"
          ><path
            fill-rule="evenodd"
            d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
            clip-rule="evenodd"></path></svg
      >
      </RollLink>
    </div>
  </section>
</MainLayout>
